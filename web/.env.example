# Web environment example
# Copy to web/.env.local for local development. Never commit real secrets.

# Production Netlify must point this at the Render API, not localhost, or uploads/chat will fail with a browser fetch error.
VITE_API_BASE_URL=http://localhost:3000

# Public site URL used for canonical SEO metadata and generated sitemap/robots files.
# Set this to the Netlify custom domain once DNS is live, e.g. https://your-domain.com
VITE_SITE_URL=http://localhost:5173

# Explicit auth cutover. Defaults to Clerk until backend and identity bindings are ready.
VITE_AUTH_PROVIDER=clerk
# WorkOS uses hosted AuthKit with same-origin /api/auth/* server sessions.
# Free AuthKit needs no paid custom authentication domain.
# VITE_WORKOS_CLIENT_ID=client_...
# Optional custom WorkOS Admin Portal hostname. Default: setup.workos.com.
# VITE_WORKOS_ADMIN_PORTAL_HOSTNAME=setup.workos.com
# Refresh credentials stay server-side; no browser development token store is used.

# Clerk auth (optional only on local loopback development; required when selected in production)
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional PostHog analytics/session replay. Analytics stays disabled unless a key is present.
# Production custom domains automatically use the same-origin Netlify proxy at /vera-insights.
# Session replay is always enabled with analytics and masks all inputs/text by default.
# VITE_PUBLIC_POSTHOG_KEY=phc_...
VITE_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
# VITE_ENABLE_ANALYTICS_IN_DEV=true

# Optional privacy-safe frontend exception monitoring. Session replay is not enabled through Sentry.
# VITE_SENTRY_DSN=https://...
