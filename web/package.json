{
  "name": "household-cfo-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-seo-files.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node scripts/design-regression.test.mjs && node scripts/privacy-regression.test.mjs && vitest run",
    "test:browser": "npm run test:browser:chromium && npm run test:browser:webkit",
    "test:browser:chromium": "playwright test --project=desktop-chrome --project=tablet-768-chrome --project=tablet-1024-chrome --project=mobile-chrome --project=compact-mobile-chrome",
    "test:browser:webkit": "playwright test --project=mobile-webkit",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.8",
    "posthog-js": "^1.395.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-plaid-link": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  }
}
